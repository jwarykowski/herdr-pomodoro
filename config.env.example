# herdr-pomodoro settings: copy to
# `$(herdr plugin config-dir jwarykowski.herdr-pomodoro)/config.env`
# and keep only what you change. Takes effect from the next phase.

# minutes
HERDR_POMODORO_WORK=25
HERDR_POMODORO_BREAK=5
HERDR_POMODORO_LONG_BREAK=15

# work rounds per long break
HERDR_POMODORO_ROUNDS=4

# 1: start the next round as soon as a break ends; 0: wait for start/toggle
HERDR_POMODORO_AUTO_CONTINUE=0

# sidebar token, used as $pomo in [ui.sidebar.spaces] rows; empty for none
HERDR_POMODORO_TOKEN=pomo

# icons in the status line, the sidebar token and notifications
HERDR_POMODORO_WORK_ICON="🍅"
HERDR_POMODORO_BREAK_ICON="☕"
HERDR_POMODORO_IDLE_ICON="⏸"
